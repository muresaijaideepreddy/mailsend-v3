DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MAILSEND_TIME_ZONE=America/Chicago
# Demo sends write private .eml files locally. No real email is sent.
MAILSEND_DELIVERY_MODE=demo
# Set a strong unique secret for production.
DJANGO_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are also accepted for compatibility.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILSEND_TOKEN_ENCRYPTION_KEY=

# Optional persistent data root. Defaults to this checkout in local development.
# Production requires an absolute persistent directory (the Docker setup uses /data).
# MAILSEND_DATA_DIR=
# DJANGO_DB_PATH may override the filename, but production requires it inside that directory.
# In production also configure exact HTTPS origins/hosts and the trusted proxy:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_REAL_DOMAIN
# DJANGO_TRUST_PROXY=true
# Secret settings also accept an explicit *_FILE path instead of the direct value.
# See docs/DEPLOYMENT.md and deploy/production.env.example for the complete setup.
