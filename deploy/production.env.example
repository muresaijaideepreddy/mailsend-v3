# Copy this template to a PRIVATE file outside the checkout, e.g.
# /etc/mailsend/production.env (readable only by the deployment operator).
# The Compose environment sets DEBUG=false, gmail mode, HTTPS URLs and /data.
# Enter real values before starting. Never commit, share or print this file.
MAILSEND_DOMAIN=
MAILSEND_TLS_EMAIL=
DJANGO_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAILSEND_TOKEN_ENCRYPTION_KEY=
MAILSEND_TIME_ZONE=America/Chicago

# Secrets also accept *_FILE instead of a direct value; mount those files read-only
# into the app container and specify their container paths. Do not set both forms.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
# MAILSEND_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key

# Optional document extraction. Leave blank to keep uploads disabled.
MAILSEND_CLAUDE_API_KEY=
MAILSEND_CLAUDE_MODEL=claude-sonnet-4-6

# Use tamu with a TAMU-issued key and model name (local testing).
MAILSEND_CLAUDE_PROVIDER=anthropic
# TAMU model example: protected.Claude Sonnet 4.6
